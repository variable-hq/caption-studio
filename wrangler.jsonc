{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "caption-studio",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTION_ROOMS",
        "class_name": "CaptionRoom"
      },
      {
        "name": "TRANSCRIPT_JOURNALS",
        "class_name": "TranscriptJournal"
      },
      {
        "name": "AI_USAGE",
        "class_name": "AiUsageLedger"
      },
      {
        "name": "OPERATOR_PREFERENCES",
        "class_name": "OperatorPreferences"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaptionRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SermonJournal", "AiUsageLedger"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["OperatorPreferences"]
    },
    {
      "tag": "v4",
      "renamed_classes": [{ "from": "SermonJournal", "to": "TranscriptJournal" }]
    }
  ]
}
