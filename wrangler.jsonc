{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "church-live-caption",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTION_ROOMS",
        "class_name": "CaptionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaptionRoom"]
    }
  ]
}
