{
  "name": "caption-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && npm run deploy:worker",
    "deploy:worker": "OPEN_NEXT_DEPLOY=true wrangler deploy",
    "deploy:check": "npm run deploy:worker -- --dry-run",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "check:adrs": "node scripts/check-adr-numbers.mjs",
    "qa": "npm run qa:all",
    "qa:operator": "npm run qa:operator:live && npm run qa:operator:settings && npm run qa:operator:presets && npm run qa:operator:transcripts",
    "qa:operator:live": "node scripts/qa/operator-live.mjs",
    "qa:operator:settings": "node scripts/qa/operator-settings.mjs",
    "qa:operator:presets": "node scripts/qa/operator-presets.mjs",
    "qa:operator:transcripts": "node scripts/qa/operator-transcripts.mjs",
    "qa:experience": "node scripts/qa/experience-ui.mjs",
    "qa:runtime": "node scripts/qa/experience-runtime.mjs",
    "qa:all": "node scripts/qa/runner.mjs",
    "validate": "npm run check:adrs && npm test -- --maxWorkers=1 && npm run typecheck:strict && npm run lint && npm run build && npm run build:cloudflare && npm run deploy:check && git diff --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "jose": "^6.1.3",
    "next": "^16.3.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
