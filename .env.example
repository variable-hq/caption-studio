# Server-side only. Add this as an encrypted Cloudflare Worker secret.
# Never prefix it with NEXT_PUBLIC_ and never commit a real value.
GROQ_API_KEY=

# Required for the reusable Main OBS channel. Generate a random value of at least
# 32 characters and store it as an encrypted Worker secret. Changing or losing it
# requires rotating the OBS URL.
OBS_CHANNEL_ENCRYPTION_KEY=

# Optional provider overrides. These defaults are production models on GroqCloud.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b

# Required in deployed environments. Copy both values from the Cloudflare Access
# application that protects this Worker.
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Optional Workers AI reader phrasing and manual summaries. Requires the AI,
# AI_USAGE and SERMON_JOURNALS bindings from wrangler.jsonc. Enable only after
# verifying the account Free plan and approved synthetic quality/privacy checks.
CAPTION_OPTIONAL_AI_ENABLED=false

# Local development only. "true" skips Cloudflare Access verification when the
# CLOUDFLARE_ACCESS_* values are unset. Never set this in a deployed Worker.
CAPTION_LOCAL_AUTH_BYPASS=
